{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xmusic",
  "version": "1.0.0",
  "identifier": "com.nys.xmusic",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "nys Xmusic", "width": 420, "height": 860 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
